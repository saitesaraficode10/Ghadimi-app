<%- include('partials/header') %>
<div class="cpanel-wrap">
<%- include('partials/user-side', { activeNav: 'requests' }) %>
<div class="cpanel-main">
<div class="admin-top">
  <h1 style="margin:0"><%= t('my_requests') %></h1>
  <a class="btn btn-ghost" href="/"><%= t('back') %></a>
</div>
<div class="table-wrap panel" style="padding:0;margin-top:1rem">
  <table>
    <thead><tr>
      <th><%= t('tracking_code') %></th><th>Property</th><th><%= t('need_from') %></th><th><%= t('rent_duration') %></th>
      <th><%= t('people_count') %></th><th><%= t('status') %></th><th>Visit</th><th>Location</th>
    </tr></thead>
    <tbody>
      <% requests.forEach(r => { %>
        <tr>
          <td><%= r.request_code %></td>
          <td><%= r.title %></td>
          <td><%= r.need_from %></td>
          <td><%= r.rent_duration %></td>
          <td><%= r.people_count %></td>
          <td><%= statusLabel(r.status) %></td>
          <td><%= r.visit_datetime || '—' %></td>
          <td><%= r.visit_location || '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% if (!requests.length) { %><p class="muted" style="text-align:center;padding:2rem">—</p><% } %>


</div>
</div>
<%- include('partials/footer') %>
