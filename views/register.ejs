<%- include('partials/header') %>
<div class="auth-wrap">
  <div class="panel auth-card">
    <h1 style="margin-top:0;text-align:center"><%= t('register') %></h1>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="POST" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (typeof invite !== 'undefined' && invite) { %>
        <input type="hidden" name="invite_token" value="<%= invite.token %>">
        <p class="muted">دعوت‌شده برای: <%= invite.phone %><% if (invite.full_name) { %> (<%= invite.full_name %>)<% } %></p>
      <% } %>
      <div>
        <label class="label">نام و نام خانوادگی *</label>
        <input class="input" name="full_name" required maxlength="80">
      </div>
      <div>
        <label class="label">شماره تماس *</label>
        <div class="phone-row">
          <select class="input" name="phone_cc" data-country-code data-prefer="+374"></select>
          <input class="input" name="phone_local" required maxlength="15" placeholder="شماره بدون صفر اول">
        </div>
      </div>
      <div>
        <label class="label">شماره واتساپ *</label>
        <div class="phone-row">
          <select class="input" name="wa_cc" data-country-code data-prefer="+374"></select>
          <input class="input" name="wa_local" required maxlength="15" placeholder="شماره بدون صفر اول">
        </div>
      </div>
      <div>
        <label class="label">رمز عبور (حداقل ۶ کاراکتر) *</label>
        <input class="input" type="password" name="password" required minlength="6" maxlength="72">
      </div>
      <button class="btn btn-primary" style="width:100%"><%= t('register') %></button>
    </form>
    <p class="muted" style="text-align:center;margin-top:1rem">کد مشتری به‌صورت خودکار از ۲۰۰ داده می‌شود.</p>
  </div>
</div>
<%- include('partials/footer') %>
