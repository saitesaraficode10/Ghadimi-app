<%- include('partials/header') %>
<div class="auth-wrap">
  <div class="panel auth-card">
    <h1 style="margin-top:0;text-align:center"><%= t('register') %></h1>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="POST" action="/register" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (typeof invite !== 'undefined' && invite) { %>
        <input type="hidden" name="invite_token" value="<%= invite.token %>">
        <p class="muted"><%= t('invite') %>: <%= invite.phone %></p>
      <% } %>
      <div>
        <label class="label"><%= t('full_name') %> *</label>
        <input class="input" name="full_name" required maxlength="80" value="<%= typeof form !== 'undefined' && form ? (form.full_name||'') : '' %>">
      </div>
      <div>
        <label class="label"><%= t('username') %> *</label>
        <input class="input" name="username" required maxlength="30" pattern="[A-Za-z0-9._]{3,30}" placeholder="user2024" dir="ltr" style="text-align:left">
        <p class="muted" style="font-size:0.75rem;margin:0.3rem 0 0"><%= t('username_hint') %></p>
      </div>
      <div>
        <label class="label"><%= t('phone') %> *</label>
        <div class="phone-row">
          <select class="input" name="phone_cc" data-country-code data-prefer="+374"></select>
          <input class="input" name="phone_local" required maxlength="15" placeholder="<%= t('phone_placeholder') %>" dir="ltr">
        </div>
      </div>
      <div>
        <label class="label"><%= t('whatsapp') %> *</label>
        <div class="phone-row">
          <select class="input" name="wa_cc" data-country-code data-prefer="+374"></select>
          <input class="input" name="wa_local" required maxlength="15" placeholder="<%= t('phone_placeholder') %>" dir="ltr">
        </div>
      </div>
      <div>
        <label class="label"><%= t('invite_optional') %></label>
        <input class="input" name="invite_code" maxlength="40" dir="ltr" placeholder="INV..." value="<%= (typeof inviteCode !== 'undefined' && inviteCode) ? inviteCode : '' %>">
      </div>
      <div>
        <label class="label"><%= t('password') %> *</label>
        <div class="pw-row">
          <input class="input" type="password" name="password" id="regPw" required minlength="8" maxlength="72">
          <button type="button" class="btn btn-ghost pw-eye" data-toggle-pw="regPw">👁</button>
        </div>
        <p class="muted" style="font-size:0.75rem;margin:0.3rem 0 0"><%= t('password_hint') %></p>
      </div>
      <button class="btn btn-primary" style="width:100%"><%= t('register') %></button>
    </form>
    <p class="muted" style="text-align:center;margin-top:1rem"><%= t('already_have_account') %> <a href="/login"><%= t('login') %></a></p>
  </div>
</div>
<%- include('partials/footer') %>
