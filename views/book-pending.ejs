<%- include('partials/header') %>
<div class="panel stack" style="max-width:560px;margin:1rem auto;text-align:center">
  <h1 style="margin:0">⏳ <%= t('pending_payment') %></h1>
  <p><%= t('tracking_code') %>: <b dir="ltr" style="font-size:1.3rem;color:var(--accent2)"><%= booking.booking_code %></b></p>
  <p class="muted">مهلت واریز و ارسال رسید: <b>۶۰ دقیقه</b></p>
  <p class="muted">تا: <span dir="ltr"><%= booking.pay_expires_at || '—' %></span></p>
  <% if (cardNum) { %>
  <div class="bank-card" style="text-align:left;margin:0.5rem 0">
    <div><%= booking.pay_card_type %></div>
    <div class="card-num" dir="ltr"><%= cardNum %></div>
  </div>
  <% } %>
  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;justify-content:center">
    <a class="btn btn-primary" href="/contact?booking=<%= booking.booking_code %>"><%= t('i_paid') %></a>
    <form method="POST" action="/book/<%= booking.booking_code %>/cancel" style="margin:0">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-ghost" type="submit"><%= t('i_cancel') %></button>
    </form>
  </div>
  <a class="btn btn-ghost" href="/book/<%= booking.booking_code %>/receipt"><%= t('print_receipt') %></a>
  <a class="btn btn-ghost" href="/my-bookings"><%= t('my_bookings') %></a>
</div>
<%- include('partials/footer') %>
