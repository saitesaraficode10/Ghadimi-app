<%- include('partials/header') %>
<div class="panel stack" style="max-width:560px;margin:1rem auto;text-align:center">
  <h1 style="margin:0">⏳ <%= t('pending_payment') %></h1>
  <p><%= t('tracking_code') %>: <b dir="ltr" style="font-size:1.35rem;color:var(--accent2)"><%= booking.booking_code %></b></p>
  <p><%= t('pay_deadline') %>: <b><%= t('minutes_60') %></b></p>
  <p class="muted" dir="ltr">Until: <%= booking.pay_expires_at || '—' %></p>
  <% if (typeof cardNum !== 'undefined' && cardNum) { %>
  <div class="bank-card" style="text-align:start;margin:0.75rem 0">
    <div><%= booking.pay_card_type %></div>
    <div class="card-num" dir="ltr"><%= cardNum %></div>
  </div>
  <% } %>
  <p class="muted"><%= t('after_pay_hint') %></p>
  <div class="stack" style="gap:0.5rem">
    <b><%= t('support') %></b>
    <% var text = encodeURIComponent((booking.booking_code || '') + ' receipt'); %>
    <% if (typeof wa1 !== 'undefined' && wa1) { %>
      <a class="btn btn-primary" target="_blank" rel="noopener" href="https://wa.me/<%= wa1 %>?text=<%= text %>"><%= label1 || t('support') %> 1 — WhatsApp</a>
    <% } %>
    <% if (typeof wa2 !== 'undefined' && wa2) { %>
      <a class="btn btn-primary" target="_blank" rel="noopener" href="https://wa.me/<%= wa2 %>?text=<%= text %>"><%= label2 || t('support') %> 2 — WhatsApp</a>
    <% } %>
    <% if ((!wa1 && !wa2)) { %>
      <a class="btn btn-primary" href="/contact"><%= t('contact') %></a>
    <% } %>
  </div>
  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;justify-content:center;margin-top:0.75rem">
    <form method="POST" action="/book/<%= booking.booking_code %>/cancel" style="margin:0">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-ghost" type="submit"><%= t('i_cancel') %></button>
    </form>
    <a class="btn btn-ghost" href="/book/<%= booking.booking_code %>/receipt"><%= t('print_receipt') %></a>
    <a class="btn btn-ghost" href="/my-bookings"><%= t('my_bookings') %></a>
  </div>
</div>
<%- include('partials/footer') %>
