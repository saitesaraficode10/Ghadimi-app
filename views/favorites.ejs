<%- include('partials/header') %>
<div class="cpanel-wrap">
<aside class="cpanel-side">
  <div class="side-brand">Ghadimi</div>
  <a href="/"><%= t('home') %></a>
  <a href="/profile"><%= t('profile') %></a>
  <a href="/my-requests"><%= t('my_requests') %></a>
  <a href="/my-bookings"><%= t('my_bookings') %></a>
  <a href="/favorites"><%= t('favorites') %></a>
  <a href="/notifications"><%= t('notifications') %></a>
  <a href="/contact"><%= t('contact') %></a>
  <a href="/logout"><%= t('logout') %></a>
</aside>
<div class="cpanel-main">
<h1><%= t('favorites') %></h1>
<div class="grid-cards" style="margin-top:1rem">
  <% properties.forEach(p => { %>
    <a class="card" href="/property/<%= p.code %>">
      <% if (p.image_path) { %><img class="card-img" src="<%= p.image_path %>" alt=""><% } else { %><div class="card-img"></div><% } %>
      <div class="card-body">
        <h2 style="margin:0;font-size:1.05rem"><%= p.title %></h2>
        <p class="muted"><%= p.city %></p>
        <div class="price"><%= Number(p.price_monthly).toLocaleString('fa-IR') %> <%= p.currency %></div>
      </div>
    </a>
  <% }) %>
</div>
<% if (!properties.length) { %><p class="muted" style="text-align:center;padding:2rem"><%= t('no_properties') %></p><% } %>


</div>
</div>
<%- include('partials/footer') %>
