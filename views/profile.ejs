<%- include('partials/header') %>
<div class="admin-top">
  <h1 style="margin:0"><%= t('profile') %></h1>
  <a class="btn btn-ghost" href="/"><%= t('back') %></a>
</div>
<p class="muted">کد: <b><%= user.user_code %></b> · <%= t('username') %>: <b dir="ltr"><%= user.username || '—' %></b></p>
<% if (error) { %><div class="alert"><%= error %></div><% } %>
<% if (ok) { %><div class="alert" style="background:rgba(52,211,153,0.15);color:#6ee7b7"><%= ok %></div><% } %>
<form method="POST" action="/profile" class="panel stack" style="max-width:520px;margin-top:1rem">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div><label class="label">نام</label><input class="input" name="full_name" required value="<%= user.full_name %>"></div>
  <div>
    <label class="label"><%= t('phone') %></label>
    <div class="phone-row">
      <select class="input" name="phone_cc" data-country-code data-prefer="+374"></select>
      <input class="input" name="phone_local" required dir="ltr" value="<%= (user.phone_am||'').replace(/^\+\d{1,3}/,'') %>">
    </div>
  </div>
  <div>
    <label class="label"><%= t('whatsapp') %></label>
    <div class="phone-row">
      <select class="input" name="wa_cc" data-country-code data-prefer="+374"></select>
      <input class="input" name="wa_local" required dir="ltr" value="<%= (user.whatsapp||'').replace(/^\+\d{1,3}/,'') %>">
    </div>
  </div>
  <button class="btn btn-primary" type="submit">ذخیره</button>
</form>
<form method="POST" action="/profile/password" class="panel stack" style="max-width:520px;margin-top:1rem">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2 style="margin:0;font-size:1rem"><%= t('change_password') %></h2>
  <div><label class="label">رمز فعلی</label>
    <div style="display:flex;gap:0.35rem"><input class="input" type="password" name="current_password" id="curPw" required style="flex:1"><button type="button" class="btn btn-ghost" data-toggle-pw="curPw">👁</button></div>
  </div>
  <div><label class="label">رمز جدید (۸+ حرف و عدد)</label>
    <div style="display:flex;gap:0.35rem"><input class="input" type="password" name="new_password" id="npw" required minlength="8" style="flex:1"><button type="button" class="btn btn-ghost" data-toggle-pw="npw">👁</button></div>
  </div>
  <button class="btn btn-primary" type="submit"><%= t('change_password') %></button>
</form>
<form method="POST" action="/profile/invite" class="panel" style="max-width:520px;margin-top:1rem">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button class="btn btn-soft" type="submit">ساخت <%= t('invite') %></button>
  <p class="muted" style="margin-top:0.5rem">کد دعوت را از پشتیبانی یا پس از ساخت در اعلان‌ها پیگیری کنید؛ ادمین هم می‌بیند.</p>
</form>
<a class="btn btn-ghost" href="/notifications" style="margin-top:0.75rem"><%= t('notifications') %></a>
<%- include('partials/footer') %>
