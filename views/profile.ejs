<%- include('partials/header') %>
<div class="cpanel-wrap">
<%- include('partials/user-side', { activeNav: 'profile' }) %>
<div class="cpanel-main">
  <h1 style="margin-top:0"><%= t('profile') %></h1>
  <p class="muted">Code: <b><%= user.user_code %></b> · <%= t('username') %>: <b dir="ltr"><%= user.username || '—' %></b></p>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <% if (ok) { %><div class="alert" style="background:rgba(52,211,153,0.15);color:#6ee7b7"><%= ok %></div><% } %>

  <form method="POST" action="/profile" class="panel stack" style="max-width:520px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label class="label"><%= t('name') %></label><input class="input" name="full_name" required value="<%= user.full_name %>"></div>
    <div>
      <label class="label"><%= t('phone') %></label>
      <div class="phone-row">
        <select class="input" name="phone_cc" data-country-code data-prefer="+374"></select>
        <input class="input" name="phone_local" required dir="ltr" value="<%= (user.phone_am||'').replace(/^\+\d{1,3}/,'') %>">
      </div>
    </div>
    <div>
      <label class="label"><%= t('whatsapp') %></label>
      <div class="phone-row">
        <select class="input" name="wa_cc" data-country-code data-prefer="+374"></select>
        <input class="input" name="wa_local" required dir="ltr" value="<%= (user.whatsapp||'').replace(/^\+\d{1,3}/,'') %>">
      </div>
    </div>
    <button class="btn btn-primary" type="submit"><%= t('submit') %></button>
  </form>

  <form method="POST" action="/profile/password" class="panel stack" style="max-width:520px;margin-top:1rem">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2 style="margin:0;font-size:1rem"><%= t('change_password') %></h2>
    <div class="pw-row">
      <input class="input" type="password" name="current_password" id="curPw" required placeholder="<%= t('current_password') %>">
      <button type="button" class="btn btn-ghost pw-eye" data-toggle-pw="curPw">👁</button>
    </div>
    <div class="pw-row">
      <input class="input" type="password" name="new_password" id="npw" required minlength="8" placeholder="<%= t('new_password') %>">
      <button type="button" class="btn btn-ghost pw-eye" data-toggle-pw="npw">👁</button>
    </div>
    <button class="btn btn-primary" type="submit"><%= t('change_password') %></button>
  </form>

  <div class="panel stack" style="max-width:560px;margin-top:1rem">
    <h2 style="margin:0;font-size:1rem"><%= t('invite') %></h2>
    <form method="POST" action="/profile/invite">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-primary" type="submit">+ <%= t('create_invite') %></button>
    </form>
    <% if (typeof invites !== 'undefined' && invites && invites.length) { %>
      <% invites.forEach(inv => { %>
        <div class="panel" style="background:rgba(0,0,0,0.2);margin-top:0.5rem">
          <div dir="ltr" style="font-family:monospace;font-weight:700"><%= inv.code %></div>
          <div class="muted"><%= t('invite_uses') %>: <b><%= inv.used_count || 0 %></b></div>
          <div class="muted" style="font-size:0.8rem;word-break:break-all" dir="ltr">
            Link: <%= (typeof baseUrl !== 'undefined' ? baseUrl : '') %>/r/<%= inv.code %>
          </div>
          <button type="button" class="btn btn-ghost" style="margin-top:0.35rem"
            data-copy="<%= (typeof baseUrl !== 'undefined' ? baseUrl : '') %>/r/<%= inv.code %>"
            data-copied-label="<%= t('copied') %>"><%= t('copy_link') %></button>
        </div>
      <% }) %>
    <% } else { %>
      <p class="muted"><%= t('no_invite_yet') %></p>
    <% } %>
    <p class="muted"><%= t('total_invites') %>: <b><%= typeof totalInvites !== 'undefined' ? totalInvites : 0 %></b></p>
  </div>
</div>
</div>
<script>
document.querySelectorAll('[data-toggle-pw]').forEach(function(btn){
  btn.addEventListener('click', function(e){
    e.preventDefault();
    var inp = document.getElementById(btn.getAttribute('data-toggle-pw'));
    if (inp) inp.type = inp.type === 'password' ? 'text' : 'password';
  });
});
</script>
<%- include('partials/footer') %>
