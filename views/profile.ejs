<%- include('partials/header') %>
<h1>پروفایل من</h1>
<p class="muted">کد مشتری: <b style="color:var(--accent2)"><%= user.user_code %></b></p>
<% if (error) { %><div class="alert"><%= error %></div><% } %>
<% if (ok) { %><div class="alert" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border-color:rgba(16,185,129,0.3)"><%= ok %></div><% } %>
<form method="POST" class="panel stack" style="max-width:520px;margin-top:1rem">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div>
    <label class="label">نام</label>
    <input class="input" name="full_name" required value="<%= user.full_name %>">
  </div>
  <div>
    <label class="label">شماره تماس</label>
    <div class="phone-row">
      <select class="input" name="phone_cc" data-country-code data-prefer="+374"></select>
      <input class="input" name="phone_local" required placeholder="بدون صفر اول" value="<%= (user.phone_am||'').replace(/^\+\d{1,3}/,'') %>">
    </div>
    <p class="muted" style="font-size:0.8rem">فعلی: <%= user.phone_am %></p>
  </div>
  <div>
    <label class="label">واتساپ</label>
    <div class="phone-row">
      <select class="input" name="wa_cc" data-country-code data-prefer="+374"></select>
      <input class="input" name="wa_local" required placeholder="بدون صفر اول" value="<%= (user.whatsapp||'').replace(/^\+\d{1,3}/,'') %>">
    </div>
    <p class="muted" style="font-size:0.8rem">فعلی: <%= user.whatsapp %></p>
  </div>
  <button class="btn btn-primary" type="submit">ذخیره تغییرات</button>
</form>
<%- include('partials/footer') %>
