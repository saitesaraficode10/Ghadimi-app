<%- include('partials/header') %>
<% if (typeof user !== 'undefined' && user) { %><div class="cpanel-wrap"><%- include('partials/user-side', { activeNav: 'contact' }) %><div class="cpanel-main"><% } %>
<h1><%= t('contact') %></h1>
<p class="muted"><%= t('support') %></p>
<div class="grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;margin-top:1rem">
  <div class="panel stack" style="text-align:center">
    <h2 style="margin:0;font-size:1.05rem"><%= label1 || (t('support') + ' 1') %></h2>
    <% if (phone1) { %><p><%= t('phone') %>: <b dir="ltr"><%= phone1 %></b></p><% } %>
    <% if (wa1) { %><p><%= t('whatsapp') %>: <b dir="ltr"><%= wa1 %></b></p><% } %>
    <% if (qrUrl1) { %>
      <img src="<%= qrUrl1 %>" alt="QR" width="220" height="220" style="border-radius:16px;background:#fff;padding:10px;margin:0.5rem auto;display:block">
      <a class="btn btn-primary" target="_blank" rel="noopener" href="https://wa.me/<%= waDigits1 %>"><%= t('whatsapp') %></a>
    <% } else { %>
      <p class="muted">—</p>
    <% } %>
  </div>
  <div class="panel stack" style="text-align:center">
    <h2 style="margin:0;font-size:1.05rem"><%= label2 || (t('support') + ' 2') %></h2>
    <% if (phone2) { %><p><%= t('phone') %>: <b dir="ltr"><%= phone2 %></b></p><% } %>
    <% if (wa2) { %><p><%= t('whatsapp') %>: <b dir="ltr"><%= wa2 %></b></p><% } %>
    <% if (qrUrl2) { %>
      <img src="<%= qrUrl2 %>" alt="QR" width="220" height="220" style="border-radius:16px;background:#fff;padding:10px;margin:0.5rem auto;display:block">
      <a class="btn btn-primary" target="_blank" rel="noopener" href="https://wa.me/<%= waDigits2 %>"><%= t('whatsapp') %></a>
    <% } else { %>
      <p class="muted">—</p>
    <% } %>
  </div>
</div>
<a class="btn btn-ghost" href="/" style="margin-top:1rem"><%= t('back') %></a>
<% if (typeof user !== 'undefined' && user) { %></div></div><% } %>
<%- include('partials/footer') %>

