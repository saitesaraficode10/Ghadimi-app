<%- include('partials/header') %>
<h1>تماس با ما</h1>
<p class="muted">برای هماهنگی بازدید و پشتیبانی در ارتباط باشید.</p>
<div class="grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;margin-top:1rem">
  <div class="panel stack" style="text-align:center">
    <h2 style="margin:0;font-size:1.05rem"><%= label1 || 'پشتیبانی ۱' %></h2>
    <% if (phone1) { %><p>تلفن: <b dir="ltr"><%= phone1 %></b></p><% } %>
    <% if (wa1) { %><p>واتساپ: <b dir="ltr"><%= wa1 %></b></p><% } %>
    <% if (qrUrl1) { %>
      <img src="<%= qrUrl1 %>" alt="QR 1" width="220" height="220" style="border-radius:16px;background:#fff;padding:10px;margin:0.5rem auto;display:block">
      <p class="muted">اسکن برای واتساپ</p>
      <a class="btn btn-primary" target="_blank" rel="noopener" href="https://wa.me/<%= waDigits1 %>">چت واتساپ</a>
    <% } else { %>
      <p class="muted">شماره از پنل ادمین تنظیم نشده</p>
    <% } %>
  </div>
  <div class="panel stack" style="text-align:center">
    <h2 style="margin:0;font-size:1.05rem"><%= label2 || 'پشتیبانی ۲' %></h2>
    <% if (phone2) { %><p>تلفن: <b dir="ltr"><%= phone2 %></b></p><% } %>
    <% if (wa2) { %><p>واتساپ: <b dir="ltr"><%= wa2 %></b></p><% } %>
    <% if (qrUrl2) { %>
      <img src="<%= qrUrl2 %>" alt="QR 2" width="220" height="220" style="border-radius:16px;background:#fff;padding:10px;margin:0.5rem auto;display:block">
      <p class="muted">اسکن برای واتساپ</p>
      <a class="btn btn-primary" target="_blank" rel="noopener" href="https://wa.me/<%= waDigits2 %>">چت واتساپ</a>
    <% } else { %>
      <p class="muted">شماره دوم را در تنظیمات ادمین وارد کنید</p>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
