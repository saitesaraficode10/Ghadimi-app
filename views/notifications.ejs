<%- include('partials/header') %>
<div class="cpanel-wrap">
<%- include('partials/user-side', { activeNav: 'notifications' }) %>
<div class="cpanel-main">
<div class="admin-top">
  <h1 style="margin:0"><%= t('notifications') %></h1>
  <a class="btn btn-ghost" href="/dashboard"><%= t('back') %></a>
</div>
<div class="stack" style="margin-top:1rem">
  <% if (rows && rows.length) { rows.forEach(n => { %>
    <a class="panel" href="/notifications/<%= n.id %>" style="display:block;text-decoration:none;color:inherit;<%= !n.is_read ? 'border-color:rgba(52,211,153,0.45)' : '' %>">
      <div style="font-weight:700"><%= n.title %> <% if (!n.is_read) { %><span class="badge-count">new</span><% } %></div>
      <div class="muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= n.body %></div>
      <div class="muted" style="font-size:0.75rem"><%= n.created_at %></div>
    </a>
  <% }) } else { %>
    <p class="muted"><%= t('no_notifications') %></p>
  <% } %>
</div>
</div>
</div>
<%- include('partials/footer') %>
