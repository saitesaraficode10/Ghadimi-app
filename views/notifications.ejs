<%- include('partials/header') %>
<div class="cpanel-wrap">
<aside class="cpanel-side">
  <div class="side-brand">Ghadimi</div>
  <a href="/"><%= t('home') %></a>
  <a href="/profile"><%= t('profile') %></a>
  <a href="/my-requests"><%= t('my_requests') %></a>
  <a href="/my-bookings"><%= t('my_bookings') %></a>
  <a href="/favorites"><%= t('favorites') %></a>
  <a href="/notifications"><%= t('notifications') %></a>
  <a href="/contact"><%= t('contact') %></a>
  <a href="/logout"><%= t('logout') %></a>
</aside>
<div class="cpanel-main">
<div class="admin-top">
  <h1 style="margin:0"><%= t('notifications') %></h1>
  <a class="btn btn-ghost" href="/"><%= t('back') %></a>
</div>
<div class="stack" style="margin-top:1rem">
  <% if (rows && rows.length) { rows.forEach(n => { %>
    <div class="panel">
      <div style="font-weight:700"><%= n.title %></div>
      <div class="muted"><%= n.body %></div>
      <div class="muted" style="font-size:0.75rem"><%= n.created_at %></div>
      <% if (n.link) { %><a href="<%= n.link %>">باز کردن</a><% } %>
    </div>
  <% }) } else { %>
    <p class="muted">اعلانی نیست</p>
  <% } %>
</div>


</div>
</div>
<%- include('partials/footer') %>
