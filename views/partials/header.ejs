<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="index,follow">
  <title><%= title %> | <%= t('site_name') %></title>
  <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/logo-nav.png">
</head>
<body>
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" style="display:flex;align-items:center;gap:0.65rem;text-decoration:none">
      <img src="/logo-nav.png" alt="Ghadimi" class="brand-logo" width="140" height="40">
    </a>
    <div class="nav-links">
      <a href="/"><%= t('home') %></a>
      <a href="/contact">تماس</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/my-requests"><%= t('my_requests') %></a>
        <a href="/favorites"><%= t('favorites') %></a>
        <a href="/logout"><%= t('logout') %></a>
      <% } else { %>
        <a href="/login"><%= t('login') %></a>
        <a class="btn btn-primary" href="/register" style="padding:0.4rem 0.9rem"><%= t('register') %></a>
      <% } %>
      <span class="lang">
        <a href="/set-lang/fa" class="<%= lang==='fa'?'active':'' %>">FA</a>
        <a href="/set-lang/en" class="<%= lang==='en'?'active':'' %>">EN</a>
        <a href="/set-lang/ru" class="<%= lang==='ru'?'active':'' %>">RU</a>
        <a href="/set-lang/hy" class="<%= lang==='hy'?'active':'' %>">HY</a>
      </span>
    </div>
  </div>
</header>
<main class="container" style="padding-top:1.25rem;padding-bottom:2rem">
