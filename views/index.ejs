<%- include('partials/header') %>
<% if (typeof user !== 'undefined' && user) { %>
<div class="cpanel-wrap">
  <%- include('partials/user-side', { activeNav: 'home' }) %>
  <div class="cpanel-main">
<% } %>
<section class="hero-card">
  <h1 style="margin:0 0 0.4rem"><%= t('site_name') %></h1>
  <p class="muted" style="margin:0"><%= t('tagline') %></p>
  <div class="theme-bar" style="margin-top:0.9rem">
    <span class="muted" style="font-size:0.8rem">Theme:</span>
    <button type="button" class="theme-dot" data-theme="emerald"></button>
    <button type="button" class="theme-dot" data-theme="ocean"></button>
    <button type="button" class="theme-dot" data-theme="violet"></button>
    <button type="button" class="theme-dot" data-theme="rose"></button>
    <button type="button" class="theme-dot" data-theme="gold"></button>
    <button type="button" class="theme-dot" data-theme="midnight"></button>
  </div>
</section>

<div class="stats-bar">
  <div class="stat-card"><b><%= typeof onlineNow !== 'undefined' ? onlineNow : '—' %></b><span class="muted"><%= t('online_now') %></span></div>
  <div class="stat-card"><b><%= typeof pageViews !== 'undefined' ? Number(pageViews).toLocaleString() : '—' %></b><span class="muted"><%= t('page_views') %></span></div>
  <div class="stat-card"><b><%= typeof uniqueVisitors !== 'undefined' ? Number(uniqueVisitors).toLocaleString() : '—' %></b><span class="muted"><%= t('visitors') %></span></div>
</div>


<% if (!filters.category) { %>
<div class="cat-gate" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin:1rem 0 1.5rem">
  <a class="panel cat-card" href="/?category=house" style="text-align:center;padding:1.5rem;text-decoration:none;color:inherit">
    <div style="font-size:2rem">🏠</div>
    <b style="font-size:1.15rem"><%= t('house') %></b>
    <p class="muted" style="margin:0.4rem 0 0"><%= t('listings') %></p>
  </a>
  <a class="panel cat-card" href="/?category=shop" style="text-align:center;padding:1.5rem;text-decoration:none;color:inherit">
    <div style="font-size:2rem">🏪</div>
    <b style="font-size:1.15rem"><%= t('shop') %></b>
    <p class="muted" style="margin:0.4rem 0 0"><%= t('listings') %></p>
  </a>
  <a class="panel cat-card" href="/?category=" style="text-align:center;padding:1.5rem;text-decoration:none;color:inherit">
    <div style="font-size:2rem">📋</div>
    <b style="font-size:1.15rem"><%= t('all') %></b>
    <p class="muted" style="margin:0.4rem 0 0"><%= t('listings') %></p>
  </a>
</div>
<% } else { %>
<p class="muted"><%= t('category') %>: <b><%= filters.category==='shop' ? t('shop') : (filters.category==='house' ? t('house') : t('all')) %></b>
  · <a href="/"><%= t('all') %></a></p>
<% } %>

<form class="filters panel" method="GET" style="margin:1rem 0;padding:1rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.5rem">
  <div>
    <label class="label"><%= t('city') %></label>
    <select class="input" name="city">
      <option value=""><%= t('all') %></option>
      <% (typeof cities !== 'undefined' ? cities : ['Yerevan','Gyumri','Vanadzor','Dilijan','Sevan']).forEach(c => { %>
        <option value="<%= c %>" <%= filters.city===c?'selected':'' %>><%= c %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label class="label"><%= t('category') %></label>
    <select class="input" name="category">
      <option value=""><%= t('all') %></option>
      <option value="house" <%= filters.category==='house'?'selected':'' %>><%= t('house') %></option>
      <option value="shop" <%= filters.category==='shop'?'selected':'' %>><%= t('shop') %></option>
    </select>
  </div>
  <div>
    <label class="label"><%= t('rent_duration') %></label>
    <select class="input" name="rent_period">
      <option value=""><%= t('all') %></option>
      <option value="daily" <%= filters.rent_period==='daily'?'selected':'' %>><%= t('rent_daily') %></option>
      <option value="monthly_1_3" <%= filters.rent_period==='monthly_1_3'?'selected':'' %>><%= t('rent_1_3') %></option>
      <option value="monthly_6_12" <%= filters.rent_period==='monthly_6_12'?'selected':'' %>><%= t('rent_6_12') %></option>
      <option value="yearly" <%= filters.rent_period==='yearly'?'selected':'' %>><%= t('rent_yearly') %></option>
    </select>
  </div>
  <div>
    <label class="label"><%= t('rooms') %></label>
    <input class="input" name="rooms" type="number" min="0" value="<%= filters.rooms || '' %>" placeholder="+">
  </div>
  <div>
    <label class="label"><%= t('price_from') %></label>
    <input class="input" name="price_from" type="number" min="0" value="<%= filters.price_from || '' %>">
  </div>
  <div>
    <label class="label"><%= t('price_to') %></label>
    <input class="input" name="price_to" type="number" min="0" value="<%= filters.price_to || '' %>">
  </div>
  <div>
    <label class="label"><%= t('status') %></label>
    <select class="input" name="status">
      <option value=""><%= t('all') %></option>
      <option value="available" <%= filters.status==='available'?'selected':'' %>><%= t('available') %></option>
      <option value="reserved" <%= filters.status==='reserved'?'selected':'' %>><%= t('reserved') %></option>
      <option value="rented" <%= filters.status==='rented'?'selected':'' %>><%= t('rented') %></option>
    </select>
  </div>
  <div style="display:flex;align-items:end">
    <button class="btn btn-primary" type="submit" style="width:100%"><%= t('filter') %></button>
  </div>
</form>

<div class="grid props">
  <% if (properties && properties.length) { properties.forEach(p => { %>
    <a class="prop-card" href="/property/<%= p.code %>">
      <div class="prop-img">
        <img src="<%= p.cover_path || p.image_path || '/logo-ghadimi.png' %>" alt="<%= locField(p, 'title') %>" loading="lazy" onerror="this.src='/logo-ghadimi.png'">
      </div>
      <div class="prop-body">
        <div style="font-weight:700"><%= locField(p, 'title') %></div>
        <div class="muted"><%= locField(p, 'city') || p.city %> · <%= p.rooms || '—' %> <%= t('rooms') %></div>
        <div style="color:var(--accent2);font-weight:800"><%= Number(p.price_monthly||0).toLocaleString() %> <%= p.currency || 'AMD' %></div>
        <div class="muted" style="font-size:0.75rem"><%= statusLabel(p.status || 'available') %> · <%= p.category || 'house' %></div>
      </div>
    </a>
  <% }) } else { %>
    <p class="muted" style="grid-column:1/-1;text-align:center;padding:2rem"><%= t('no_properties') %></p>
  <% } %>
</div>
<% if (typeof user !== 'undefined' && user) { %>
  </div>
</div>
<% } %>
<%- include('partials/footer') %>

