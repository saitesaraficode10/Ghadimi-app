<%- include('../partials/header') %>
<div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1rem">
  <h1 style="margin:0">مدیریت ملک‌ها</h1>
  <a class="btn btn-primary" href="/admin/properties/new">+ افزودن ملک</a>
</div>
<a class="muted" href="/admin">← داشبورد</a>
<div class="table-wrap panel" style="padding:0;margin-top:1rem">
  <table>
    <thead>
      <tr>
        <th>کد</th><th>عنوان</th><th>قیمت</th><th>وضعیت</th><th>آزاد از</th><th>عملیات</th>
      </tr>
    </thead>
    <tbody>
      <% properties.forEach(p => { %>
        <tr>
          <td><code><%= p.code %></code></td>
          <td><%= p.title %></td>
          <td><%= Number(p.price_monthly).toLocaleString('fa-IR') %></td>
          <td><%= statusLabel(p.status) %></td>
          <td><%= p.available_from || '—' %></td>
          <td style="display:flex;gap:0.5rem;flex-wrap:wrap">
            <a class="btn btn-ghost" style="padding:0.3rem 0.7rem" href="/admin/properties/<%= p.id %>/edit">ویرایش</a>
            <form method="POST" action="/admin/properties/<%= p.id %>/delete" onsubmit="return confirm('این ملک حذف شود؟');" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-ghost" type="submit" style="padding:0.3rem 0.7rem;color:#fca5a5">حذف</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
