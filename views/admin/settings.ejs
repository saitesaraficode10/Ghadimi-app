<%- include('../partials/header') %>
<h1>تنظیمات</h1>
<form method="POST" action="/admin/settings" class="panel stack" style="max-width:640px;margin-top:1rem">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2 style="margin:0;font-size:1rem">پشتیبانی ۱</h2>
  <div><label class="label">عنوان</label><input class="input" name="contact_label" value="<%= contact_label %>"></div>
  <div><label class="label">واتساپ ۱ (با کد کشور)</label><input class="input" name="contact_whatsapp" value="<%= contact_whatsapp %>" dir="ltr" placeholder="+374..."></div>
  <div><label class="label">تلفن ۱</label><input class="input" name="contact_phone" value="<%= contact_phone %>" dir="ltr"></div>

  <h2 style="margin:0.75rem 0 0;font-size:1rem">پشتیبانی ۲</h2>
  <div><label class="label">عنوان</label><input class="input" name="contact_label2" value="<%= typeof contact_label2!=='undefined'?contact_label2:'' %>"></div>
  <div><label class="label">واتساپ ۲</label><input class="input" name="contact_whatsapp2" value="<%= typeof contact_whatsapp2!=='undefined'?contact_whatsapp2:'' %>" dir="ltr" placeholder="+374..."></div>
  <div><label class="label">تلفن ۲</label><input class="input" name="contact_phone2" value="<%= typeof contact_phone2!=='undefined'?contact_phone2:'' %>" dir="ltr"></div>

  <h2 style="margin:0.75rem 0 0;font-size:1rem">واترمارک عکس‌ها</h2>
  <div><label class="label">آدرس سایت (روی عکس)</label><input class="input" name="site_url" value="<%= typeof site_url!=='undefined'?site_url:'' %>" dir="ltr" placeholder="https://yoursite.com"></div>

  <h2 style="margin:0.75rem 0 0;font-size:1rem">کارت پیش‌پرداخت</h2>
  <div>
    <label class="label"><input type="checkbox" name="pay_card_ir_enabled" value="1" <%= pay_card_ir_enabled==='1'?'checked':'' %>> کارت ایران</label>
    <input class="input" name="pay_card_ir" value="<%= pay_card_ir %>" dir="ltr">
  </div>
  <div>
    <label class="label"><input type="checkbox" name="pay_card_am_enabled" value="1" <%= pay_card_am_enabled==='1'?'checked':'' %>> کارت ارمنستان</label>
    <input class="input" name="pay_card_am" value="<%= pay_card_am %>" dir="ltr">
  </div>
  <div>
    <label class="label"><input type="checkbox" name="pay_card_visa_enabled" value="1" <%= pay_card_visa_enabled==='1'?'checked':'' %>> Visa</label>
    <input class="input" name="pay_card_visa" value="<%= pay_card_visa %>" dir="ltr">
  </div>
  <div><label class="label">توضیح</label><textarea class="input" name="pay_card_note" rows="2"><%= pay_card_note %></textarea></div>
  <button class="btn btn-primary" type="submit">ذخیره</button>
</form>
<p style="margin-top:1rem"><a class="btn btn-ghost" href="/admin">بازگشت</a></p>
<%- include('../partials/footer') %>
