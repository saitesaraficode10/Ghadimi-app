<%- include('../partials/header') %>
<h1>تنظیمات</h1>
<form method="POST" class="panel stack" style="max-width:560px;margin-top:1rem">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2 style="margin:0;font-size:1rem">تماس و پشتیبانی</h2>
  <div><label class="label">واتساپ</label><input class="input" name="contact_whatsapp" value="<%= contact_whatsapp %>"></div>
  <div><label class="label">تلفن</label><input class="input" name="contact_phone" value="<%= contact_phone %>"></div>
  <div><label class="label">عنوان</label><input class="input" name="contact_label" value="<%= contact_label %>"></div>
  <div><label class="label">کد بعدی مشتری</label><input class="input" type="number" min="200" name="next_user_code" value="<%= next_user_code %>"></div>

  <h2 style="margin:0.5rem 0 0;font-size:1rem">کارت‌های پیش‌پرداخت (آنلاین)</h2>
  <div>
    <label class="label"><input type="checkbox" name="pay_card_ir_enabled" value="1" <%= pay_card_ir_enabled==='1'?'checked':'' %>> فعال: کارت ایران</label>
    <input class="input" name="pay_card_ir" value="<%= pay_card_ir %>" placeholder="شماره کارت ایران">
  </div>
  <div>
    <label class="label"><input type="checkbox" name="pay_card_am_enabled" value="1" <%= pay_card_am_enabled==='1'?'checked':'' %>> فعال: کارت ارمنستان</label>
    <input class="input" name="pay_card_am" value="<%= pay_card_am %>" placeholder="شماره کارت ارمنستان">
  </div>
  <div>
    <label class="label"><input type="checkbox" name="pay_card_visa_enabled" value="1" <%= pay_card_visa_enabled==='1'?'checked':'' %>> فعال: Visa</label>
    <input class="input" name="pay_card_visa" value="<%= pay_card_visa %>" placeholder="Visa card">
  </div>
  <div>
    <label class="label">توضیح برای مشتری</label>
    <textarea class="input" name="pay_card_note" rows="3"><%= pay_card_note %></textarea>
  </div>
  <button class="btn btn-primary" type="submit">ذخیره</button>
</form>
<p style="margin-top:1rem"><a class="btn btn-ghost" href="/admin">بازگشت</a></p>
<%- include('../partials/footer') %>
