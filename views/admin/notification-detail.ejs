  <a class="btn btn-ghost" href="/admin/notifications"><%= t('back') %></a>
</div>
<div class="panel stack" style="margin-top:1rem;max-width:640px">
  <h2 style="margin:0"><%= n.title %></h2>
  <p style="white-space:pre-wrap;line-height:1.8"><%= n.body %></p>
