<%- include('../partials/header') %>
<div class="admin-top">
  <h1 style="margin:0">اعلان‌های ادمین</h1>
  <a class="btn btn-ghost" href="/admin"><%= t('back') %></a>
</div>
<div class="stack" style="margin-top:1rem">
  <% rows.forEach(n => { %>
    <div class="panel">
      <div style="font-weight:700"><%= n.title %></div>
      <div class="muted"><%= n.body %></div>
      <div class="muted" style="font-size:0.75rem"><%= n.created_at %></div>
      <% if (n.link) { %><a href="<%= n.link %>">باز کردن</a><% } %>
    </div>
  <% }) %>
  <% if (!rows.length) { %><p class="muted">خالی</p><% } %>
</div>
<%- include('../partials/footer') %>
