<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ورود ادمین | Ghadimi</title>
  <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-wrap">
    <form method="POST" action="/admin/login" class="panel auth-card stack" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <h1 style="margin:0;text-align:center">ورود ادمین</h1>
      <p class="muted" style="text-align:center;margin:0">Ghadimi Amlak</p>
      <% if (error) { %><div class="alert"><%= error %></div><% } %>
      <div>
        <label class="label">نام کاربری</label>
        <input class="input" name="username" placeholder="admin1" required maxlength="40" autocomplete="username">
      </div>
      <div>
        <label class="label">رمز عبور</label>
        <div style="display:flex;gap:0.35rem">
        <input class="input" type="password" name="password" id="adminPw" placeholder="رمز" required maxlength="72" autocomplete="current-password" style="flex:1">
        <button type="button" class="btn btn-ghost" data-toggle-pw="adminPw">👁</button>
      </div>
      </div>
      <button class="btn btn-primary" type="submit">ورود</button>
      <a href="/" class="muted" style="text-align:center">بازگشت به سایت</a>
    </form>
  </div>
</body>
</html>
