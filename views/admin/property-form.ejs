<%- include('../partials/header') %>
<div class="admin-top">
  <h1 style="margin:0"><%= property ? 'ویرایش ملک' : 'افزودن ملک' %></h1>
  <a class="btn btn-ghost" href="/admin/properties"><%= t('back') %></a>
</div>
<% if (error) { %><div class="alert" style="margin:1rem 0"><%= error %></div><% } %>
<form method="POST" enctype="multipart/form-data" class="panel stack" style="max-width:680px;margin-top:1rem">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (!property) { %>
    <div><label class="label"><%= t('property_code') %> *</label><input class="input" name="code" required maxlength="30" placeholder="A-101"></div>
  <% } else { %>
    <div><label class="label"><%= t('property_code') %></label><input class="input" value="<%= property.code %>" disabled></div>
  <% } %>
  <div class="panel stack" style="background:rgba(0,0,0,0.2);padding:0.85rem;border-radius:12px">
    <b>عنوان به چند زبان *</b>
    <div><label class="label">فارسی (اصلی) *</label><input class="input" name="title" required maxlength="120" value="<%= property ? property.title : '' %>"></div>
    <div><label class="label">English</label><input class="input" name="title_en" maxlength="120" dir="ltr" value="<%= property && property.title_en ? property.title_en : '' %>"></div>
    <div><label class="label">Русский</label><input class="input" name="title_ru" maxlength="120" dir="ltr" value="<%= property && property.title_ru ? property.title_ru : '' %>"></div>
    <div><label class="label">Հայերեն</label><input class="input" name="title_hy" maxlength="120" value="<%= property && property.title_hy ? property.title_hy : '' %>"></div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem">
    <div>
      <label class="label">دسته‌بندی *</label>
      <select class="input" name="category">
        <option value="house" <%= !property || property.category!=='shop'?'selected':'' %>>خانه</option>
        <option value="shop" <%= property && property.category==='shop'?'selected':'' %>>مغازه</option>
      </select>
    </div>
    <div>
      <label class="label">نوع اجاره (خانه)</label>
      <select class="input" name="rent_period">
        <option value="daily" <%= property && property.rent_period==='daily'?'selected':'' %>>روزانه</option>
        <option value="monthly_1_3" <%= !property || property.rent_period==='monthly_1_3' || !property.rent_period?'selected':'' %>>ماهانه ۱–۳ ماه</option>
        <option value="monthly_6_12" <%= property && property.rent_period==='monthly_6_12'?'selected':'' %>>ماهانه ۶–۱۲ ماه</option>
        <option value="yearly" <%= property && property.rent_period==='yearly'?'selected':'' %>>سالیانه</option>
      </select>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem">
    <div>
      <label class="label">شهر</label>
      <select class="input" name="city">
        <% ['Yerevan','Gyumri','Vanadzor','Dilijan','Tsaghkadzor','Sevan','Kapan','Armavir','Abovyan','Hrazdan','Ashtarak','Ijevan','Artashat','Goris','Jermuk'].forEach(c => { %>
          <option value="<%= c %>" <%= (property ? property.city : 'Yerevan')===c?'selected':'' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="label">آدرس/محله (فارسی)</label>
      <input class="input" name="address" value="<%= property && property.address ? property.address : '' %>">
      <input class="input" name="address_en" placeholder="Address EN" dir="ltr" value="<%= property && property.address_en ? property.address_en : '' %>" style="margin-top:0.3rem">
      <input class="input" name="address_ru" placeholder="Адрес RU" dir="ltr" value="<%= property && property.address_ru ? property.address_ru : '' %>" style="margin-top:0.3rem">
      <input class="input" name="address_hy" placeholder="Հասցե HY" value="<%= property && property.address_hy ? property.address_hy : '' %>" style="margin-top:0.3rem">
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.6rem">
    <div><label class="label">اتاق</label><input class="input" type="number" name="rooms" min="0" value="<%= property ? property.rooms : 1 %>"></div>
    <div><label class="label">متراژ</label><input class="input" type="number" name="area" min="0" value="<%= property && property.area ? property.area : '' %>"></div>
    <div><label class="label">حداکثر نفرات</label><input class="input" type="number" name="max_people" min="1" value="<%= property && property.max_people ? property.max_people : 2 %>"></div>
  </div>

  <div style="display:grid;grid-template-columns:2fr 1fr;gap:0.6rem">
    <div><label class="label">قیمت ماهانه *</label><input class="input" type="number" name="price_monthly" required min="0" value="<%= property ? property.price_monthly : '' %>"></div>
    <div>
      <label class="label">ارز *</label>
      <select class="input" name="currency" required>
        <% ['AMD','USD','EUR','IRR','RUB'].forEach(cur => { %>
          <option value="<%= cur %>" <%= (property && property.currency ? property.currency : 'AMD')===cur?'selected':'' %>><%= cur %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div>
    <label class="label">وضعیت</label>
    <select class="input" name="status">
      <option value="available" <%= !property || property.status==='available'?'selected':'' %>>آزاد</option>
      <option value="reserved" <%= property && property.status==='reserved'?'selected':'' %>>رزرو</option>
      <option value="rented" <%= property && property.status==='rented'?'selected':'' %>>اجاره رفته</option>
    </select>
  </div>
  <div><label class="label">از تاریخ آزاد</label><input class="input" type="date" name="available_from" value="<%= property && property.available_from ? property.available_from : '' %>"></div>
  <div class="panel stack" style="background:rgba(0,0,0,0.2);padding:0.85rem;border-radius:12px">
    <b>توضیحات به چند زبان</b>
    <div><label class="label">فارسی</label><textarea class="input" name="description" rows="3"><%= property && property.description ? property.description : '' %></textarea></div>
    <div><label class="label">English</label><textarea class="input" name="description_en" rows="3" dir="ltr"><%= property && property.description_en ? property.description_en : '' %></textarea></div>
    <div><label class="label">Русский</label><textarea class="input" name="description_ru" rows="3" dir="ltr"><%= property && property.description_ru ? property.description_ru : '' %></textarea></div>
    <div><label class="label">Հայերեն</label><textarea class="input" name="description_hy" rows="3"><%= property && property.description_hy ? property.description_hy : '' %></textarea></div>
  </div>
  <div><label class="label">لینک نقشه</label><input class="input" name="map_url" dir="ltr" value="<%= property && property.map_url ? property.map_url : '' %>"></div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem">
    <div><label class="label">واتساپ ملک ۱</label><input class="input" name="contact_whatsapp" dir="ltr" placeholder="+374..." value="<%= property && property.contact_whatsapp ? property.contact_whatsapp : '' %>"></div>
    <div><label class="label">واتساپ ملک ۲</label><input class="input" name="contact_whatsapp2" dir="ltr" placeholder="+374..." value="<%= property && property.contact_whatsapp2 ? property.contact_whatsapp2 : '' %>"></div>
  </div>

  <div>
    <label class="label">عکس‌ها (چندتایی)</label>
    <input class="input" type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple>
  </div>
  <button class="btn btn-primary" type="submit">ذخیره</button>
</form>
<%- include('../partials/footer') %>
