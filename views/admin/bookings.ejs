<%- include('../partials/header') %>
<div class="admin-top">
  <form method="GET" action="/admin/bookings" style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.75rem">
  <input class="input" name="q" value="<%= typeof q!=='undefined'?q:'' %>" placeholder="کد رزرو / کد ملک / نام / تلفن" style="min-width:14rem">
  <button class="btn btn-primary" type="submit"><%= t('search') %></button>
</form>
<p class="muted"><%= t('booking_manage') %></p>
<h1 style="margin:0">رزروها</h1>
  <a class="btn btn-ghost" href="/admin"><%= t('back') %></a>
</div>
<form method="POST" action="/admin/bookings/manual" class="panel stack" style="max-width:640px;margin:1rem 0">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2 style="margin:0;font-size:1rem">رزرو دستی حضوری</h2>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem">
    <input class="input" name="user_code" placeholder="کد کاربر" required>
    <input class="input" name="property_code" placeholder="کد ملک" required>
    <input class="input" type="date" name="start_date" required>
    <input class="input" type="date" name="end_date">
  </div>
  <button class="btn btn-primary" type="submit">ثبت رزرو حضوری</button>
</form>
<div class="table-wrap panel" style="padding:0">
  <table>
    <thead><tr><th>کد</th><th>کاربر</th><th>ملک</th><th>پرداخت</th><th>وضعیت</th><th>مهلت</th><th></th></tr></thead>
    <tbody>
      <% rows.forEach(r => { %>
        <tr>
          <td><%= r.booking_code %></td>
          <td><%= r.full_name %> (<%= r.user_code %>)</td>
          <td><%= r.property_code %></td>
          <td><%= r.pay_method %> / <%= r.pay_card_type || '—' %></td>
          <td><%= statusLabel(r.status) %></td>
          <td dir="ltr" style="font-size:0.75rem"><%= r.pay_expires_at || '—' %></td>
          <td>
            <a href="/book/<%= r.booking_code %>/receipt" target="_blank">رسید</a>
            <% if (r.status==='pending_payment' || r.status==='pending') { %>
            <form method="POST" action="/admin/bookings/<%= r.booking_code %>/cancel" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input class="input" name="reason" placeholder="دلیل لغو" style="width:8rem;display:inline-block">
              <button class="btn btn-ghost" type="submit" style="padding:0.2rem 0.5rem">لغو</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
